# Dependency direction between layers (docs/spec/architecture.md "Layers"): a library depends only
# on the rows above it. No upward and no sideways dependency.
#
# Two checks share one table:
#   muckaiiCheckLayers()  at configure time: the real link graph of every muckaii<Layer> target.
#   script mode           (cmake -DmuckaiiRoot=<repo> -P MuckaiiLayers.cmake, run by ctest as
#                         repoLayerIncludes): every #include "muckaii/<layer>/..." in src/.

set(muckaiiLayers transport mud persistence session client audio core tui)

# The "Depends on" column of the architecture table. Direct dependencies only; a layer may also
# include headers of what those depend on, because session re-emits mud events and so on.
set(muckaiiDependsTransport "")
set(muckaiiDependsMud "")
set(muckaiiDependsPersistence "")
set(muckaiiDependsSession transport mud persistence)
set(muckaiiDependsClient session)
set(muckaiiDependsAudio mud)
set(muckaiiDependsCore transport mud persistence session client audio)
set(muckaiiDependsTui core client)

# The layers reachable from <layer> through the table, not including <layer>.
function(muckaiiLayerClosure layer out)
    string(SUBSTRING "${layer}" 0 1 head)
    string(SUBSTRING "${layer}" 1 -1 tail)
    string(TOUPPER "${head}" head)
    set(pending ${muckaiiDepends${head}${tail}})
    set(seen "")
    while(pending)
        list(POP_FRONT pending next)
        if(NOT next IN_LIST seen)
            list(APPEND seen ${next})
            string(SUBSTRING "${next}" 0 1 nextHead)
            string(SUBSTRING "${next}" 1 -1 nextTail)
            string(TOUPPER "${nextHead}" nextHead)
            list(APPEND pending ${muckaiiDepends${nextHead}${nextTail}})
        endif()
    endwhile()
    set(${out} ${seen} PARENT_SCOPE)
endfunction()

function(muckaiiCheckLayerIncludes root)
    set(violations "")
    foreach(layer IN LISTS muckaiiLayers)
        muckaiiLayerClosure(${layer} reachable)
        file(GLOB_RECURSE files "${root}/src/${layer}/*.cpp" "${root}/src/${layer}/*.hpp"
             "${root}/src/${layer}/*.h")
        foreach(file IN LISTS files)
            file(STRINGS "${file}" lines REGEX "^[ \t]*#[ \t]*include[ \t]*\"muckaii/")
            foreach(line IN LISTS lines)
                string(REGEX MATCH "\"muckaii/([a-z]+)/" ignored "${line}")
                set(included "${CMAKE_MATCH_1}")
                if(NOT included STREQUAL layer AND NOT included IN_LIST reachable)
                    list(APPEND violations "${file}: layer '${layer}' includes '${included}'")
                endif()
            endforeach()
        endforeach()
    endforeach()
    if(violations)
        list(JOIN violations "\n    " text)
        message(FATAL_ERROR "Layer include direction violated (docs/spec/architecture.md):\n    ${text}")
    endif()
    message(STATUS "Layer include direction holds")
endfunction()

function(muckaiiCheckLayers)
    set(violations "")
    foreach(layer IN LISTS muckaiiLayers)
        muckaiiLayerTarget(${layer} libTarget)
        if(layer STREQUAL tui)
            set(targets ${libTarget})
        else()
            set(targets ${libTarget} ${libTarget}Tests)
        endif()
        string(SUBSTRING "${layer}" 0 1 head)
        string(SUBSTRING "${layer}" 1 -1 tail)
        string(TOUPPER "${head}" head)
        foreach(target IN LISTS targets)
            if(NOT TARGET ${target})
                list(APPEND violations "missing target ${target}")
                continue()
            endif()
            get_target_property(linked ${target} LINK_LIBRARIES)
            get_target_property(interface ${target} INTERFACE_LINK_LIBRARIES)
            foreach(lib IN LISTS linked interface)
                string(REGEX REPLACE "^\\$<LINK_ONLY:(.*)>$" "\\1" lib "${lib}")
                if(lib MATCHES "^muckaii([A-Z][a-z]*)$")
                    string(TOLOWER "${CMAKE_MATCH_1}" dep)
                    # A test target may link its own layer; a library only what the table lists.
                    if(NOT dep STREQUAL layer AND NOT dep IN_LIST muckaiiDepends${head}${tail})
                        list(APPEND violations
                             "${target} links ${lib}; '${layer}' may depend on: ${muckaiiDepends${head}${tail}}")
                    endif()
                endif()
            endforeach()
        endforeach()
    endforeach()
    if(violations)
        list(JOIN violations "\n    " text)
        message(FATAL_ERROR "Layer dependency direction violated (docs/spec/architecture.md):\n    ${text}")
    endif()
    muckaiiCheckLayerIncludes("${CMAKE_SOURCE_DIR}")
endfunction()

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
    if(NOT muckaiiRoot)
        message(FATAL_ERROR "pass -DmuckaiiRoot=<repo root>")
    endif()
    muckaiiCheckLayerIncludes("${muckaiiRoot}")
endif()
