---
# The director's C++ style, mechanised (docs/style.md). Run by scripts/check-tidy.py.
# Exceptions are disabled in the build (/EHs-c- _HAS_EXCEPTIONS=0, -fno-exceptions), so a throw does not compile.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  clang-analyzer-*,
  cppcoreguidelines-no-malloc,
  cppcoreguidelines-owning-memory,
  cppcoreguidelines-pro-type-cstyle-cast,
  google-readability-casting,
  misc-const-correctness,
  misc-definitions-in-headers,
  misc-unused-using-decls,
  modernize-*,
  -modernize-use-trailing-return-type,
  -modernize-avoid-c-arrays,
  performance-*,
  -performance-enum-size,
  readability-const-return-type,
  readability-identifier-naming,
  readability-implicit-bool-conversion,
  readability-isolate-declaration,
  readability-make-member-function-const,
  readability-non-const-parameter,
  readability-redundant-*,
  readability-simplify-boolean-expr,
  readability-static-definition-in-anonymous-namespace
WarningsAsErrors: '*'
HeaderFilterRegex: '.*/src/.*'
FormatStyle: none
CheckOptions:
  # Types: PascalCase.
  readability-identifier-naming.NamespaceCase: lower_case
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.UnionCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.TypedefCase: CamelCase
  readability-identifier-naming.TemplateParameterCase: CamelCase
  readability-identifier-naming.ConceptCase: CamelCase
  # Functions, variables, parameters: camelCase.
  readability-identifier-naming.FunctionCase: camelBack
  readability-identifier-naming.MethodCase: camelBack
  readability-identifier-naming.VariableCase: camelBack
  readability-identifier-naming.ParameterCase: camelBack
  readability-identifier-naming.ParameterPackCase: camelBack
  # Members: m prefix. Class-level statics and constants are k-prefixed constants.
  readability-identifier-naming.MemberCase: CamelCase
  readability-identifier-naming.MemberPrefix: m
  readability-identifier-naming.ConstantMemberCase: CamelCase
  readability-identifier-naming.ConstantMemberPrefix: m
  readability-identifier-naming.ClassMemberCase: camelBack
  # Constants: k prefix, for true constants only. A const local or parameter is an ordinary
  # camelCase variable (`const Creature& creature`).
  readability-identifier-naming.ConstexprVariableCase: CamelCase
  readability-identifier-naming.ConstexprVariablePrefix: k
  readability-identifier-naming.GlobalConstantCase: CamelCase
  readability-identifier-naming.GlobalConstantPrefix: k
  readability-identifier-naming.GlobalConstantPointerCase: CamelCase
  readability-identifier-naming.GlobalConstantPointerPrefix: k
  readability-identifier-naming.StaticConstantCase: CamelCase
  readability-identifier-naming.StaticConstantPrefix: k
  readability-identifier-naming.ClassConstantCase: CamelCase
  readability-identifier-naming.ClassConstantPrefix: k
  readability-identifier-naming.EnumConstantCase: CamelCase
  readability-identifier-naming.EnumConstantPrefix: k
  readability-identifier-naming.LocalConstantCase: camelBack
  readability-identifier-naming.LocalConstantPointerCase: camelBack
  readability-identifier-naming.ConstantParameterCase: camelBack
  readability-identifier-naming.ConstantPointerParameterCase: camelBack
  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
  # Strict const hygiene.
  misc-const-correctness.AnalyzeValues: true
  misc-const-correctness.AnalyzeReferences: true
  misc-const-correctness.WarnPointersAsValues: true
  misc-const-correctness.WarnPointersAsPointers: true
  misc-const-correctness.TransformValues: false
  misc-const-correctness.TransformReferences: false
  misc-const-correctness.TransformPointersAsValues: false
  readability-implicit-bool-conversion.AllowPointerConditions: true
...
